# ============================================
# Owly X 情报监控系统 - 环境变量
# 复制为 .env 后填入实际凭据
# ============================================

# Twitter API v2 Bearer Token（可选，不填用 Nitter 降级）
# 获取: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# Grok API Key（日报模式必填）
# 获取: https://console.x.ai/
GROK_API_KEY=
GROK_MODEL=grok-3-beta
# GROK_BASE_URL=https://api.x.ai/v1

# 飞书机器人 Webhook（必填）
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/f4db43ee-38db-4753-b4f0-b5d100471e8e

# 飞书签名校验 Secret（可选）
LARK_WEBHOOK_SECRET=
