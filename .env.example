# ============================================
# Owly X 情报监控系统 - 环境变量
# 复制此文件为 .env 后填入实际凭据
# ============================================

# Twitter API v2 Bearer Token（可选，不填则用 Nitter 降级）
# 获取: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# 飞书机器人 Webhook（必填）
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/f4db43ee-38db-4753-b4f0-b5d100471e8e

# 飞书签名校验 Secret（可选，设了安全校验才填）
LARK_WEBHOOK_SECRET=

# 高优/普通通道（可选，不填则统一用上述 Webhook）
LARK_HIGH_PRIORITY_WEBHOOK=
LARK_NORMAL_WEBHOOK=
